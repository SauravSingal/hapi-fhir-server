          <script>// HL7 v2 ADT^A01 to FHIR R4 Transformer
// Mirth automatically parses HL7 into the &apos;msg&apos; object

// ── Extract from MSH segment ──
var messageId   = msg[&apos;MSH&apos;][&apos;MSH.10&apos;][&apos;MSH.10.1&apos;].toString();
var messageType = msg[&apos;MSH&apos;][&apos;MSH.9&apos;][&apos;MSH.9.1&apos;].toString()
                + &apos;^&apos;
                + msg[&apos;MSH&apos;][&apos;MSH.9&apos;][&apos;MSH.9.2&apos;].toString();

// ── Extract from PID segment ──
var patientId   = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var familyName  = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var givenName   = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();
var dob         = msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;].toString();
var gender      = msg[&apos;PID&apos;][&apos;PID.8&apos;][&apos;PID.8.1&apos;].toString().toLowerCase();
var street      = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.1&apos;].toString();
var city        = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.3&apos;].toString();
var state       = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.4&apos;].toString();
var postal      = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.5&apos;].toString();

// ── Extract from PV1 segment ──
var ward        = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.1&apos;].toString();
var room        = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.2&apos;].toString();
var admitDate   = msg[&apos;PV1&apos;][&apos;PV1.44&apos;][&apos;PV1.44.1&apos;].toString();

// ── Format DOB: HL7 is YYYYMMDD, FHIR wants YYYY-MM-DD ──
function formatDate(hl7Date) {
    if (!hl7Date || hl7Date.length &lt; 8) return null;
    return hl7Date.substring(0,4) + &apos;-&apos;
         + hl7Date.substring(4,6) + &apos;-&apos;
         + hl7Date.substring(6,8);
}

// ── Format DateTime for Encounter period ──
function formatDateTime(hl7DT) {
    if (!hl7DT || hl7DT.length &lt; 8) return null;
    var d = formatDate(hl7DT.substring(0,8));
    var time = hl7DT.length &gt;= 12
        ? hl7DT.substring(8,10) + &apos;:&apos; + hl7DT.substring(10,12) + &apos;:00&apos;
        : &apos;00:00:00&apos;;
    return d + &apos;T&apos; + time;
}

// ── Map HL7 gender to FHIR ──
function mapGender(g) {
    if (g === &apos;m&apos;) return &apos;male&apos;;
    if (g === &apos;f&apos;) return &apos;female&apos;;
    return &apos;unknown&apos;;
}

// ── Build FHIR Patient resource ──
var patientResource = {
    resourceType: &apos;Patient&apos;,
    id: patientId,
    identifier: [{
        system: &apos;urn:oid:2.16.840.1.113883.4.1&apos;,
        value: patientId
    }],
    name: [{
        use: &apos;official&apos;,
        family: familyName,
        given: [givenName]
    }],
    birthDate: formatDate(dob),
    gender: mapGender(gender),
    address: [{
        use: &apos;home&apos;,
        line: [street],
        city: city,
        state: state,
        postalCode: postal
    }]
};

// ── Build FHIR Encounter resource ──
var encounterId = &apos;enc-&apos; + patientId + &apos;-&apos; + messageId;
var encounterResource = {
    resourceType: &apos;Encounter&apos;,
    id: encounterId,
    status: &apos;in-progress&apos;,
    class: {
        system: &apos;http://terminology.hl7.org/CodeSystem/v3-ActCode&apos;,
        code: &apos;IMP&apos;,
        display: &apos;inpatient encounter&apos;
    },
    subject: {
        reference: &apos;Patient/&apos; + patientId
    },
    location: [{
        location: {
            display: ward + &apos; Room &apos; + room
        }
    }],
    period: {
        start: formatDateTime(admitDate)
    }
};

// ── Build final payload for Spring Boot ──
var payload = {
    messageId: messageId,
    messageType: messageType,
    rawHl7: connectorMessage.getRawData(),
    patientResource: JSON.stringify(patientResource),
    encounterResource: JSON.stringify(encounterResource)
};

// Set as channel message for destination to pick up
channelMap.put(&apos;payload&apos;, JSON.stringify(payload));</script>
